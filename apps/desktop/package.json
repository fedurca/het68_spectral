{
  "name": "@het68/desktop",
  "version": "2.0.5",
  "private": true,
  "description": "Electron shell for the het68 spectral analyzer",
  "author": "het68",
  "main": "main.cjs",
  "scripts": {
    "start": "pnpm --filter @het68/web run build && electron .",
    "dev": "electron . --dev",
    "selftest": "electron . --selftest",
    "dist": "pnpm --filter @het68/web run build && electron-builder --mac dmg",
    "dist:snap": "pnpm --filter @het68/web run build && electron-builder --linux snap"
  },
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.0.24"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "build": {
    "appId": "cz.het68.spectral",
    "productName": "het68 spectral",
    "executableName": "het68-spectral",
    "extraMetadata": {
      "name": "het68-spectral"
    },
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "capture.cjs",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "het68 spectral records six-channel audio from the detection cube for spectrogram analysis."
      }
    },
    "afterPack": "./afterPack.cjs",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "icon": "resources/icon.png",
      "synopsis": "Spectrogram analyzer for the het68 six-microphone detection cube",
      "description": "Six-channel spectrograms, DOA, signatures and Remote ID ground truth for the het68 acoustic detection cube."
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "strict",
        "grade": "stable",
        "summary": "Spectrogram analyzer for the het68 detection cube",
        "useDestructiveMode": true,
        "plugs": [
          "default",
          "audio-record",
          "audio-playback",
          "alsa",
          "pulseaudio",
          "serial-port",
          "home",
          "removable-media"
        ],
        "stagePackages": [
          "default",
          "ffmpeg"
        ]
      }
    }
  }
}
