{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    // The workspace packages are consumed as TypeScript sources rather than built
    // output, so the ambient declaration for the Emscripten artifact has to be in
    // this program too.
    "../../packages/dsp-core/src/wasm-module.d.ts"
  ]
}
